# Secrets
.env

# macOS
.DS_Store
.AppleDouble
.LSOverrideIcon
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# OneDrive temp files
~$*

# Nedlastede tabellmetadata (lastes ned av eget oppdaterings-script,
# leses av scripts/generate-seo-pages.mjs)
data/table-metadata/*.json

# Kun devDependency (playwright-core, for E2E-laget i tests/e2e/).
# Appen og enhetstestene kjører uten npm install.
node_modules/

# Git
.gitignore.local
# Lokale Claude Code-innstillinger (settings.local.json m.m.).
# Delte skills og delte innstillinger (permissions + hooks) sjekkes inn;
# settings.local.json er maskinspesifikk og blir liggende utenfor.
.claude/*
!.claude/skills/
!.claude/settings.json
